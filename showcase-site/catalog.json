          "id": "v1",
          "title": "建立五级能源语言",
          "change": "按设定绘制五级能源设施，采用低多边形三视角。",
          "reason": "先验证技术题材与整体美术方向。",
          "outcome": "T3–T5 均偏科幻，等级差异仍不够清楚。"
        },
        {
          "id": "v2",
          "title": "拉开高阶技术轮廓",
          "change": "重做 T3–T5：电池柜、球形反应舱、装甲核能塔。",
          "reason": "需要在缩小展示时识别科技递进。",
          "outcome": "形成化学储能 → 核反应 → 基地级核能的结构差异。"
        },
        {
          "id": "v3",
          "title": "适配正方形占地",
          "change": "调整五级设备布局、底座与支撑，统一方形占地。",
          "reason": "配合游戏内设施摆放与网格规则。",
          "outcome": "明确主体底面的形状约束。"
        },
        {
          "id": "v4",
          "title": "加入统一投料交互",
          "change": "正面右下加入共用投料口，T4 改为箱式。",
          "reason": "玩家需要固定且易识别的物资投放位置。",
          "outcome": "统一入口结构，但 T4 的箱体整合仍显生硬。"
        },
        {
          "id": "v5",
          "title": "重构 T4 与技术徽标",
          "change": "重做一体式 T4；增加朝上外伸方管和三类技术徽标。",
          "reason": "修正占地、视图与技术识别，并试验投料方式。",
          "outcome": "引入俯视图检查布局，外伸管道作为交互方案探索。"
        },
        {
          "id": "v6",
          "title": "收回投料管道",
          "change": "移除外伸方管，仅在正面装饰面板保留嵌入式口。",
          "reason": "简化外轮廓，保留明确的投料位置。",
          "outcome": "设施重新回到完整方形占地。"
        },
        {
          "id": "v7",
          "title": "同尺度 · 简化定型",
          "change": "统一体量、底座与操作件比例；精简管线、螺栓和外挂。",
          "reason": "与机床 v2 统一美术语言，以技术机制表达等级。",
          "outcome": "最新展示版本：五级同尺度，保留方形底座、技术徽标与嵌入口。"
        }
      ],
